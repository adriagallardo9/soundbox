{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundbox",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}

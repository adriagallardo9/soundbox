# ==========================================
# SoundBoxd - Variables d'Entorn (.env)
# ==========================================

# API de Spotify (Opcional - si no es configuren, s'activa el Pla B automàtic amb dades locals)
VITE_SPOTIFY_CLIENT_ID=el_teu_spotify_client_id
VITE_SPOTIFY_CLIENT_SECRET=el_teu_spotify_client_secret

# Google OAuth (obligatori per al login amb Google)
# Crea les credencials a: https://console.cloud.google.com/apis/credentials
# Tipus: "OAuth 2.0 Client ID" → Aplicació web
# Origins autoritzats: http://localhost:3000
# URIs de redirecció: http://localhost:3000
VITE_GOOGLE_CLIENT_ID=el_teu_google_client_id.apps.googleusercontent.com

# Supabase / Backend API URL (Opcional si s'utilitza persistència integrada)
VITE_SUPABASE_URL=https://exemple.supabase.co
VITE_SUPABASE_ANON_KEY=la_teva_supabase_anon_key

# Configuració de l'aplicació
VITE_APP_NAME=SoundBoxd
VITE_APP_ENV=development
